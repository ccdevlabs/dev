#!/usr/bin/env bash
# Install TPM (Tmux Plugin Manager). Plugins install on first tmux launch via `prefix + I`.
set -euo pipefail

TPM_DIR="$HOME/.tmux/plugins/tpm"

if [[ -d "$TPM_DIR" ]]; then
    echo "TPM already installed, pulling latest."
    git -C "$TPM_DIR" pull --ff-only
else
    git clone https://github.com/tmux-plugins/tpm "$TPM_DIR"
    echo "TPM installed."
fi

echo "Open tmux and press prefix + I (Ctrl-a I) to install plugins."
