#!/usr/bin/env bash
set -euo pipefail

# macOS system preferences via `defaults write`. Idempotent.
# Pinned from the live machine snapshot 2026-05-15 + dev-friendly additions.

# ── Dock ────────────────────────────────────────────────────────────────────
defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock autohide-delay -float 0               # no pause before slide-in
defaults write com.apple.dock autohide-time-modifier -float 0.4     # snappy animation
defaults write com.apple.dock show-recents -bool false              # hide recent-apps tile
defaults write com.apple.dock tilesize -int 33                      # compact
defaults write com.apple.dock minimize-to-application -bool false   # keep separate minimized tiles
defaults write com.apple.dock orientation -string "right"           # dock on right side
defaults write com.apple.dock wvous-br-corner -int 14               # bottom-right hot corner = Quick Note
defaults write com.apple.dock wvous-br-modifier -int 0

# ── Finder ──────────────────────────────────────────────────────────────────
defaults write com.apple.finder ShowPathbar -bool true
defaults write com.apple.finder ShowStatusBar -bool true
defaults write com.apple.finder FXPreferredViewStyle -string "clmv"         # column view
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false  # no popup on rename
defaults write com.apple.finder _FXSortFoldersFirst -bool true              # folders before files
defaults write com.apple.finder NewWindowTarget -string "PfDo"              # new windows open at...
defaults write com.apple.finder NewWindowTargetPath -string "file://${HOME}/Documents/"

# Filesystem hygiene — no .DS_Store on shares/USB
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# ── Keyboard ────────────────────────────────────────────────────────────────
defaults write NSGlobalDomain KeyRepeat -int 2                      # fastest repeat
defaults write NSGlobalDomain InitialKeyRepeat -int 25              # slight pause before repeat
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false  # disable accent popup (vim-friendly)
defaults write NSGlobalDomain AppleKeyboardUIMode -int 2            # full keyboard access
defaults write NSGlobalDomain AppleShowAllExtensions -bool true

# ── UI ──────────────────────────────────────────────────────────────────────
defaults write NSGlobalDomain AppleInterfaceStyle -string "Dark"
defaults write NSGlobalDomain NSWindowResizeTime -float 0.001       # near-instant window resize

# ── Trackpad ────────────────────────────────────────────────────────────────
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerDrag -bool true
defaults write -g com.apple.mouse.tapBehavior -int 1                # tap-to-click at login too

# ── Screenshots ─────────────────────────────────────────────────────────────
mkdir -p "$HOME/Screenshots"
defaults write com.apple.screencapture location -string "$HOME/Screenshots"
defaults write com.apple.screencapture disable-shadow -bool true    # no shadow on window shots

# ── Time Machine ────────────────────────────────────────────────────────────
defaults write com.apple.TimeMachine DoNotOfferNewDisksForBackup -bool true

# ── Siri / Spotlight (Raycast replaces both) ───────────────────────────────
# Disable Siri
defaults write com.apple.assistant.support "Assistant Enabled" -bool false
defaults write com.apple.Siri VoiceTriggerUserEnabled -bool false           # no "Hey Siri"
defaults write com.apple.Siri StatusMenuVisible -bool false                 # hide menu bar icon

# Disable Spotlight's network-aware suggestions (privacy + speed)
defaults write com.apple.lookup.shared LookupSuggestionsDisabled -bool true

# Free Cmd+Space for Raycast — disable Spotlight's hotkey (64) and Spotlight-window hotkey (65)
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 64 \
    '{enabled = 0; value = { parameters = (32, 49, 1048576); type = "standard"; }; }'
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 65 \
    '{enabled = 0; value = { parameters = (32, 49, 1572864); type = "standard"; }; }'

# Full Spotlight indexing disable (optional, requires sudo, run manually):
#   sudo mdutil -a -i off
# Skipped from this script because:
#   - requires a sudo prompt mid-bootstrap
#   - breaks Raycast file search, `mdfind`, and `mdls`
#   - indexing settles down after the initial pass anyway

# ── Locale (Taiwan: English / Traditional Chinese / Japanese) ───────────────
defaults write NSGlobalDomain AppleLocale -string "en_TW"
defaults write NSGlobalDomain AppleLanguages -array "en-TW" "zh-Hant-TW" "ja-TW"

# ── Mission Control / Spaces ────────────────────────────────────────────────
# MANUAL STEP: open Mission Control (F3), click + nine times to create 9 spaces.
# macOS has no API to create spaces programmatically.

# No slide animation when switching spaces (uses instant crossfade instead).
defaults write com.apple.universalaccess reduceMotion -bool true

# Ctrl+1..9 → jump to desktop 1..9.
# Hotkey IDs 118–126 = "Switch to Desktop N".
# parameters = (unicodeChar, keyCode, modifierFlags); Ctrl = 262144.
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 118 \
    '{enabled = 1; value = { parameters = (49, 18, 262144); type = "standard"; }; }'
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 119 \
    '{enabled = 1; value = { parameters = (50, 19, 262144); type = "standard"; }; }'
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 120 \
    '{enabled = 1; value = { parameters = (51, 20, 262144); type = "standard"; }; }'
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 121 \
    '{enabled = 1; value = { parameters = (52, 21, 262144); type = "standard"; }; }'
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 122 \
    '{enabled = 1; value = { parameters = (53, 23, 262144); type = "standard"; }; }'
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 123 \
    '{enabled = 1; value = { parameters = (54, 22, 262144); type = "standard"; }; }'
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 124 \
    '{enabled = 1; value = { parameters = (55, 26, 262144); type = "standard"; }; }'
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 125 \
    '{enabled = 1; value = { parameters = (56, 28, 262144); type = "standard"; }; }'
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 126 \
    '{enabled = 1; value = { parameters = (57, 25, 262144); type = "standard"; }; }'

# Hotkeys need a reactivate cycle to take effect (handled below by killing Dock).

# ── Apply ───────────────────────────────────────────────────────────────────
for app in "Dock" "Finder" "SystemUIServer"; do
    killall "$app" &>/dev/null || true
done
echo "macOS defaults applied."
echo "Note: AppleInterfaceStyle, AppleLanguages, and AppleLocale changes take effect after logout/restart."
echo ""
echo "ACTION REQUIRED — create 9 Mission Control spaces manually:"
echo "  1. Open Mission Control (F3 or three-finger swipe up)"
echo "  2. Click the '+' button in the top-right corner 9 times"
echo "  3. Ctrl+1 through Ctrl+9 will then jump to each desktop instantly"
