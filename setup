#!/usr/bin/env bash
set -euo pipefail

# Bootstrap a fresh M-series Mac.
# Hosted at: https://raw.githubusercontent.com/ccdevlabs/dev/main/setup
#
# Usage on a fresh machine:
#   curl -fsSL https://raw.githubusercontent.com/ccdevlabs/dev/main/setup | bash

REPO_URL="https://github.com/ccdevlabs/dev"
DEST="$HOME/personal/dev"

# 1. Xcode Command Line Tools — provides git, clang, make
if ! xcode-select -p &>/dev/null; then
    echo "Installing Xcode Command Line Tools (a GUI prompt will appear)..."
    xcode-select --install
    until xcode-select -p &>/dev/null; do sleep 5; done
fi

# 2. Homebrew — M-series path is /opt/homebrew
if ! command -v brew &>/dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

# 3. Clone the dev repo
mkdir -p "$(dirname "$DEST")"
if [ ! -d "$DEST" ]; then
    git clone "$REPO_URL" "$DEST"
fi

# 4. Hand off to the dispatcher
cd "$DEST"
DEV_ENV=$(pwd) ./run
